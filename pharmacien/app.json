{
  "expo": {
    "name": "Pharmacien remplaçant",
    "slug": "pharmacien-remplacant",
    "scheme": "pharmacien",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "userInterfaceStyle": "light",
      "supportsTablet": true,
      "bundleIdentifier": "com.pharmacien.remplacant",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.pharmacien.remplacant",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L’accès à la localisation sert uniquement à convertir l’adresse d’une pharmacie en coordonnées pour calculer la distance."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F6F6B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
